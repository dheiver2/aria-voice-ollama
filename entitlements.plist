<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  NOTA: este arquivo NÃO é usado pelo build.sh atual. O app é assinado ad-hoc SEM
  entitlements (codesign --force --sign -), pois é local e não-sandbox: os prompts
  TCC de microfone/voz são disparados pelas usage strings do Info.plist, e a
  Automação/Acessibilidade são concedidas no primeiro uso. Embedar entitlements de
  sandbox sem app-sandbox causava falha de launch (RBS code 163).

  As chaves NSMicrophoneUsageDescription / NSSpeechRecognitionUsageDescription foram
  removidas daqui — elas pertencem ao Info.plist (não são entitlements válidos).
  Mantido apenas como referência caso se opte por hardened runtime no futuro.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
